# MongoDB connection string (docker compose provides local one)
MONGODB_URI=mongodb://localhost:27017/nest-auth

# JWT signing secret (use a long random string; generate via `openssl rand -base64 48`)
JWT_SECRET=change-me
JWT_EXPIRES=86400

# Backend HTTP port
PORT=3001

# Frontend origin allowed via CORS
FRONTEND_ORIGIN=http://localhost:3000
